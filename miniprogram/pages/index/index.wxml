<!--pages/index/index.wxml-->
<view class="page">
  <!-- 头部 -->
  <view class="header">
    <text class="header__title">来一声 ✨</text>
    <text class="header__sub">点一下，听一下</text>
  </view>

  <!-- 分类标签 -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="tab {{activeCategory === item.id ? 'tab--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSwitchCategory"
    >{{item.emoji}} {{item.name}}</view>
  </scroll-view>

  <!-- emoji 按钮网格 -->
  <view class="grid">
    <view
      wx:for="{{filtered}}"
      wx:key="id"
      class="btn btn--{{item.color}} {{currentId === item.id ? 'btn--playing' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTapSound"
    >
      <text class="btn__emoji">{{item.emoji}}</text>
      <text class="btn__label">{{item.label}}</text>
      <view wx:if="{{currentId === item.id}}" class="btn__pulse"></view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="footer">
    <text class="footer__text">长按按钮可收藏 · 共 {{sounds.length}} 个声音</text>
  </view>
</view>
