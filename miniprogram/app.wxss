/**app.wxss**/
page {
  background: linear-gradient(180deg, #FBEAF0 0%, #F6F6F6 28%);
  min-height: 100vh;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2C2C2A;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
